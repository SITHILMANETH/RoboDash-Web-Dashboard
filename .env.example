# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
PORT=3000
# Bind to 127.0.0.1 when a reverse proxy (Caddy/Nginx) sits in front; 0.0.0.0 to serve the LAN directly.
HOST=127.0.0.1
# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Number of proxies in front of the app (1 for Caddy/Nginx/Cloudflare Tunnel). Leave empty when none.
TRUST_PROXY=1
# Optional: store data outside the project folder
# DATA_DIR=/var/lib/robodash
